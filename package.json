{
  "name": "rescueroute",
  "version": "1.0.0",
  "description": "Agentic AI food-rescue dispatcher: Gemini plans routes for surplus food to NGOs, code verifies every constraint, and coordinators approve every dispatch.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/*.test.js\"",
    "lint": "eslint . && node scripts/check-syntax.js",
    "evaluate": "node --disable-warning=ExperimentalWarning scripts/evaluate.js",
    "check:gemini": "node --disable-warning=ExperimentalWarning scripts/check-gemini.js",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/*.test.js\"",
    "audit": "npm audit --omit=dev",
    "check": "npm run lint && npm test && npm run audit"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  },
  "keywords": [
    "agentic-ai",
    "gemini",
    "food-rescue",
    "sustainability",
    "logistics",
    "express",
    "sqlite",
    "hackathon"
  ],
  "author": "RescueRoute team (PromptWars Hackathon 2026)"
}
