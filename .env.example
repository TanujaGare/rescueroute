# Copy to .env and fill in. Never commit .env.

# Google Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run with the deterministic fallback planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated backups used automatically if the primary is overloaded or rate limited.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite

# Required in production: at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for the seeded demo accounts.
DEMO_PASSWORD=tanuja
# One-click "Try instant demo" guest sign-in (set to false to disable).
DEMO_LOGIN_ENABLED=true

PORT=8080
NODE_ENV=development
DB_PATH=data/rescueroute.db
# Set to true when running behind a load balancer (Render, Cloud Run).
TRUST_PROXY=false

# Agent limits (optional)
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=60
AGENT_MODEL_TIMEOUT_MS=25000
AGENT_MODEL_RETRIES=2
AGENT_RATE_LIMIT_BACKOFF_MS=8000
AGENT_RUN_BUDGET_MS=120000
